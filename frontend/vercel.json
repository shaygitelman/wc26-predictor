{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/sync-live",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/reconcile-knockouts",
      "schedule": "0 1 * * *"
    }
  ]
}
