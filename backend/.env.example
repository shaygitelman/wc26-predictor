DATABASE_URL=postgresql://postgres:password@localhost:5432/wc26
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]

# Sentry error monitoring — get DSN from https://sentry.io/
# Leave blank to disable (safe in development).
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Injected by Railway: set to $RAILWAY_GIT_COMMIT_SHA in your Railway service variables
SENTRY_RELEASE=
