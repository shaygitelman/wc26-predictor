DATABASE_URL=postgresql://postgres:password@localhost:5432/wc26
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]

# Sentry error monitoring — get DSN from https://sentry.io/
# Leave blank to disable (safe in development).
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Optional: set to git commit SHA for Sentry release tracking (e.g. $RENDER_GIT_COMMIT in Render)
SENTRY_RELEASE=
